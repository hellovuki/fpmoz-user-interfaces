{
  "paths": {
    "/marvelHeroes": {
      "get": {
        "tags": ["Marvel heroes"],
        "description": "Get all marvel heroes",
        "parameters": [
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "example": "name"
            },
            "description": "Sort field"
          },
          {
            "in": "query",
            "name": "sortType",
            "schema": {
              "type": "string",
              "enum": ["ASC", "DESC"],
              "example": "ASC"
            },
            "description": "Sort type"
          }
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "marvelHeroes": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/MarvelHeroBase"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          }
        }
      },
